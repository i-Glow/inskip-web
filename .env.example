# Template only: copy to .env.local and fill in. Never commit real values.

# --- Front (Vite) -----------------------------------------------------------
# Local: .env.local. Production: Vercel project environment variables.
# Public values (Supabase Settings > API); data is protected by RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Edge Function score-idea (Supabase secrets) ----------------------------
# Set with: npx supabase secrets set AI_MODE=mock
# SUPABASE_URL and SUPABASE_ANON_KEY are injected by Supabase automatically.
AI_MODE=mock
# V2 only (AI_MODE=live):
AI_API_KEY=
AI_MODEL=

# --- Supabase CLI (db push, functions deploy) -------------------------------
# Local use of the CLI, and GitHub Actions secrets/variables for CI.
SUPABASE_ACCESS_TOKEN=     # secret: supabase.com/dashboard/account/tokens
SUPABASE_DB_PASSWORD=      # secret: Project Settings > Database
SUPABASE_PROJECT_REF=      # variable: project ref (xxxx in xxxx.supabase.co)

# --- Vercel deploy (GitHub Actions) -----------------------------------------
VERCEL_TOKEN=              # secret: vercel.com/account/tokens
VERCEL_ORG_ID=             # variable: .vercel/project.json "orgId"
VERCEL_PROJECT_ID=         # variable: .vercel/project.json "projectId"
